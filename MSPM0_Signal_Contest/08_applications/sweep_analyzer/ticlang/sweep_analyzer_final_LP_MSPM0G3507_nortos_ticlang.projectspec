<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when><context deviceFamily="ARM" deviceId="MSPM0G3507" /></when>
    </applicability>
    <project
        name="sweep_analyzer_final"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G3507"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/11_legacy_compatibility/algorithms/03_measurement/adc_to_voltage
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/03_measurement/common
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/05_precision/lock_in
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/01_bsp/common
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/02_acquisition/adc_dma
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/06_generator/dac_dma
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/06_generator/dac_wave_table
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/06_generator/dds
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/06_generator/frequency_sweep
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/06_generator/sine
            -I${MSPM0_SIGNAL_LIBRARY_ROOT}/MSPM0_Signal_Contest/08_applications/common
            -I${APP_SOURCE_ROOT}
            -DSIGNAL_MATH_BACKEND=0
            -DARM_MATH_CM0
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/DSP/Include
            -std=c11
            -O2
            -g
            -Wall
            -Werror
            -ffunction-sections
            -fdata-sections
            @device.opt
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
        "
        linkerBuildOptions="
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a

        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Round 1 full-link baseline: Sweep Analyzer">
        <pathVariable name="APP_SOURCE_ROOT" path="../" scope="project"/>
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../main.c" openOnCreation="false" excludeFromBuild="false" action="copy" />
        <file path="../signal_config.h" openOnCreation="false" excludeFromBuild="false" action="copy" />
        <file path="../README.md" openOnCreation="false" excludeFromBuild="false" action="copy" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/09_examples/integration_profiles/PROFILE_04_ADC_DAC/profile.syscfg" openOnCreation="true" excludeFromBuild="false" action="link" />
        <file path="../signal_sweep_analyzer.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/08_applications/common/signal_dac_dma_platform.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/02_acquisition/adc_dma/signal_adc_dma.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/06_generator/dac_dma/signal_dac_dma.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/06_generator/dac_wave_table/signal_dac_wave_table.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/06_generator/dds/signal_dds.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/06_generator/sine/signal_sine.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/06_generator/frequency_sweep/signal_frequency_sweep.c" targetDirectory="sources/peripheral_and_glue" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/11_legacy_compatibility/algorithms/03_measurement/adc_to_voltage/signal_adc_to_voltage.c" targetDirectory="sources/algorithm" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="MSPM0_SIGNAL_LIBRARY_ROOT/MSPM0_Signal_Contest/05_precision/lock_in/signal_lock_in.c" targetDirectory="sources/algorithm" createVirtualFolders="true" openOnCreation="false" excludeFromBuild="false" action="link" />
    </project>
</projectSpec>
